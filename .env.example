# radio zukka — environment variables (copy to .env and fill in)
#
# On the server, deploy this as an EnvironmentFile for the systemd units,
# e.g. `/etc/zukka.env` (chmod 600). See AGENT.md → systemd units.

# AzuraCast
ZUKKA_RADIO_HOST=https://cast.zukkafabrik.de
ZUKKA_RADIO_API_KEY=replace_with_api_key
# Optional: ZUKKA_STATION_ID=1
# Optional: ZUKKA_WEBHOOK_PORT=5099

# Telegram (production bot + channel)
TELEGRAM_BOT_API_KEY=replace_with_bot_token
TELEGRAM_CHANNEL=@zukka_radio

# Telegram (dev/test channel — optional)
TELEGRAM_BOT_API_KEY_TEST=replace_with_test_bot_token
TELEGRAM_CHANNEL_TEST=replace_with_test_channel_id

# Funkwhale (music.zukkafabrik.de)
# Admin credentials used by recording_watcher.py for import + metadata.
# FUNKWHALE_PASSWORD is required for Funkwhale import.
FUNKWHALE_ADMIN=admin
FUNKWHALE_PASSWORD=replace_with_password
FUNKWHALE_LIBRARY=replace_with_library_uuid
# Optional: FUNKWHALE_COMPOSE=/srv/funkwhale/docker-compose.yml
# Optional: FUNKWHALE_MUSIC_DIR=/srv/funkwhale/data/music

# Paths (optional overrides — defaults match the production server)
# ZUKKA_RECORDINGS_DIR=/var/lib/docker/volumes/azuracast_station_data/_data/zukka_radio/recordings
# ZUKKA_RECORDING_STATE=/srv/azuracast/recording_state.json
# ZUKKA_COVER_DIR=/opt/http/radio.zukkafabrik.de/covers
