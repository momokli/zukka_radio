# radio zukka v2 — DEV environment (example)
# Copy to .env and fill in secrets. Never commit the real .env.

# ── Environment ───────────────────────────────────────────────
ZUKKA_ENV=dev
ZUKKA_BASE_DOMAIN=zukkafabrik.de
ZUKKA_LOG=info

# ── Domains ───────────────────────────────────────────────────
ZUKKA_DOMAIN_RADIO=radio.dev.zukkafabrik.de
ZUKKA_DOMAIN_CAST=cast.dev.zukkafabrik.de
ZUKKA_DOMAIN_PORTAL=portal.dev.zukkafabrik.de
ZUKKA_DOMAIN_TAPES=tapes.dev.zukkafabrik.de

# ── Host ports (DEV block: 121xx) ─────────────────────────────
ZUKKA_PORT_ICECAST=12100
ZUKKA_PORT_HARBOR=12101
ZUKKA_PORT_SCHEDULER=12110
ZUKKA_PORT_CADDY=12180
ZUKKA_PORT_CADDY_TLS=12181

# ── Database ──────────────────────────────────────────────────
ZUKKA_DB_PATH=/data/zukka.db

# ── Secrets (generate with: openssl rand -hex 32) ─────────────
ZUKKA_SESSION_SECRET=change-me-dev-session
ZUKKA_CSRF_SECRET=change-me-dev-csrf
ZUKKA_HARBOR_PEPPER=change-me-dev-harbor
ZUKKA_SCHEDULER_SERVICE_TOKEN=change-me-dev-scheduler
ZUKKA_LIQUIDSOAP_TOKEN=change-me-dev-liquidsoap
ZUKKA_MUSIC_API_TOKEN=change-me-dev-music-api

# ── Music API / Hub (consumed) ────────────────────────────────
ZUKKA_MUSIC_API_URL=https://music.dev.zukkafabrik.de
ZUKKA_MUSIC_HUB_URL=https://hub.dev.zukkafabrik.de

# ── Telegram ──────────────────────────────────────────────────
ZUKKA_TELEGRAM_BOT_TOKEN=
ZUKKA_TELEGRAM_CHAT_ID=
# DEV: wenn gesetzt, gehen Announcements in den Test-Chat statt in den Hauptkanal.
ZUKKA_TELEGRAM_CHAT_ID_TEST=
# Scheduler-Poll-Intervall für fällige Announcements (Sekunden, Minimum 1).
ZUKKA_ANNOUNCEMENT_POLL_SECS=15

# ── Liquidsoap ────────────────────────────────────────────────
ZUKKA_LIQUIDSOAP_HARBOR_PORT=8001
ZUKKA_LIQUIDSOAP_CONTROL_PORT=8010
# Scheduler → Liquidsoap push (internal back network). Unset = push disabled.
ZUKKA_LIQUIDSOAP_CONTROL_URL=http://liquidsoap:8010/control
ZUKKA_HARBOR_SLOTS=32

# ── Tapes ─────────────────────────────────────────────────────
ZUKKA_TAPE_SLUG_LENGTH=8
ZUKKA_WAVEFORM_MS_PER_BAR=500

# ── Upload ────────────────────────────────────────────────────
ZUKKA_UPLOAD_MAX_BYTES=2147483648
