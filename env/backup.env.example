# radio zukka — Backup environment (host only, NOT for the containers)
# Install as /etc/zukka/backup.env (0600 root:root). Consumed by the systemd
# timers (zukka-backup.service, zukka-restore-drill.service,
# zukka-backup-prune.service) and by `zukka-deploy prod` for the pre-deploy
# snapshot. See docs/backup.md.

# Own restic repo path on the StorageBox — isolated from the generic
# planet backup so a `forget --prune` never shortens the radio history.
RESTIC_REPOSITORY=rclone:sbox01:/home/Backups/restic-planet-zukka

# Repo password file (0600 root). Generate once with: openssl rand -hex 32.
RESTIC_PASSWORD_FILE=/etc/zukka/restic.pw

# Optional overrides (defaults in the script):
# ZUKKA_BACKUP_DB_SRC=/var/lib/docker/volumes/zukka-prod_zukka_data/_data/zukka.db
# ZUKKA_BACKUP_KEEP_DAILY=14
# ZUKKA_BACKUP_KEEP_WEEKLY=8
# ZUKKA_BACKUP_KEEP_MONTHLY=6
# ZUKKA_BACKUP_RTO_SECONDS=1800
