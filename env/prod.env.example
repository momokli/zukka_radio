# radio zukka v2 — PROD environment (example)
# Copy to .env and fill in secrets. Never commit the real .env.

# ── Environment ───────────────────────────────────────────────
ZUKKA_ENV=prod
ZUKKA_BASE_DOMAIN=zukkafabrik.de
ZUKKA_LOG=info

# ── Images (set by the deploy wrapper) ────────────────────────
# zukka-deploy exports ZUKKA_TAG=<sha> at deploy time; the registry is stable.
# The placeholder below is NOT a valid image tag on its own.
ZUKKA_IMAGE_REGISTRY=ghcr.io/momokli
ZUKKA_TAG=<sha>

# ── Domains ───────────────────────────────────────────────────
ZUKKA_DOMAIN_RADIO=radio.zukkafabrik.de
ZUKKA_DOMAIN_CAST=cast.zukkafabrik.de
ZUKKA_DOMAIN_PORTAL=portal.zukkafabrik.de
ZUKKA_DOMAIN_TAPES=tapes.zukkafabrik.de

# ── Host ports (PROD block: 120xx) ────────────────────────────
ZUKKA_PORT_ICECAST=12000
ZUKKA_PORT_HARBOR=12001
ZUKKA_PORT_SCHEDULER=12010
ZUKKA_PORT_CADDY=12080
ZUKKA_PORT_CADDY_TLS=12443

# ── Database ──────────────────────────────────────────────────
ZUKKA_DB_PATH=/data/zukka.db

# ── Secrets (generate with: openssl rand -hex 32) ─────────────
ZUKKA_SESSION_SECRET=
ZUKKA_CSRF_SECRET=
ZUKKA_HARBOR_PEPPER=
ZUKKA_SCHEDULER_SERVICE_TOKEN=
ZUKKA_LIQUIDSOAP_TOKEN=
ZUKKA_MUSIC_API_TOKEN=

# ── Music API / Hub (consumed) ────────────────────────────────
ZUKKA_MUSIC_API_URL=https://music.zukkafabrik.de
ZUKKA_MUSIC_HUB_URL=https://hub.zukkafabrik.de

# ── Telegram ──────────────────────────────────────────────────
ZUKKA_TELEGRAM_BOT_TOKEN=
ZUKKA_TELEGRAM_CHAT_ID=
# In prod/anderen Umgebungen wird dieser Test-Channel ignoriert (nur ZUKKA_ENV=dev).
ZUKKA_TELEGRAM_CHAT_ID_TEST=
# Scheduler-Poll-Intervall für fällige Announcements (Sekunden, Minimum 1).
ZUKKA_ANNOUNCEMENT_POLL_SECS=15

# ── Liquidsoap ────────────────────────────────────────────────
ZUKKA_LIQUIDSOAP_HARBOR_PORT=8001
ZUKKA_LIQUIDSOAP_CONTROL_PORT=8010
# Scheduler → Liquidsoap push (internal back network). Unset = push disabled.
ZUKKA_LIQUIDSOAP_CONTROL_URL=http://liquidsoap:8010/control
ZUKKA_HARBOR_SLOTS=32

# Scheduler → Icecast status poll for the Deploy-Gate (#42). Unset/leer =
# Default http://icecast:8000/status-json.xsl (scheduler und icecast teilen
# das `back`-Netz). Der Host kann hier explizit einen Wert setzen.
ZUKKA_ICECAST_STATUS_URL=

# ── Tapes ─────────────────────────────────────────────────────
ZUKKA_TAPE_SLUG_LENGTH=8
ZUKKA_WAVEFORM_MS_PER_BAR=500

# ── Upload ────────────────────────────────────────────────────
ZUKKA_UPLOAD_MAX_BYTES=2147483648

# ── Monitoring (#44, §3.8) ────────────────────────────────────
# Dedizierter Prometheus-Listener des Schedulers (compose setzt diesen Wert).
ZUKKA_METRICS_BIND=0.0.0.0:9091
# Labels für zukka_build_info; leer = Fallback (CARGO_PKG_VERSION für version,
# leerer sha). Werden im Build (Dockerfile-ARG + CI) gesetzt.
ZUKKA_VERSION=
ZUKKA_GIT_SHA=
