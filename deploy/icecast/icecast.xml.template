<?xml version="1.0" encoding="UTF-8"?>
<!-- radio zukka — Icecast config TEMPLATE (DEV/PROD shared).
     Icecast 2.4.4 does NOT substitute environment variables in its XML config,
     so this template is rendered at container start by docker-entrypoint.sh
     (envsubst, package gettext-base) into /etc/icecast2/icecast.xml.

     Only the three password placeholders and the admin user below are
     substituted; every other `$` in this file is left untouched by scoping
     envsubst to exactly those variables. Secrets are supplied via the
     ZUKKA_ICECAST_* environment (see env/*.env.example, docs/infrastructure.md);
     the entrypoint fails fast when a required secret is missing. -->
<icecast>
    <location>Zukka Fabrik</location>
    <admin>ops@zukkafabrik.de</admin>

    <limits>
        <clients>100</clients>
        <sources>4</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <source-password>${ZUKKA_ICECAST_SOURCE_PASSWORD}</source-password>
        <relay-password>${ZUKKA_ICECAST_RELAY_PASSWORD}</relay-password>
        <admin-user>${ZUKKA_ICECAST_ADMIN_USER}</admin-user>
        <admin-password>${ZUKKA_ICECAST_ADMIN_PASSWORD}</admin-password>
    </authentication>

    <hostname>localhost</hostname>

    <listen-socket>
        <port>8000</port>
    </listen-socket>

    <http-headers>
        <header name="Access-Control-Allow-Origin" value="*" />
    </http-headers>

    <mount>
        <mount-name>/stream.mp3</mount-name>
        <public>0</public>
    </mount>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>-</accesslog>
        <errorlog>-</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
        <changeowner>
            <user>icecast2</user>
            <group>icecast</group>
        </changeowner>
    </security>
</icecast>
