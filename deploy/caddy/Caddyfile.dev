# DEV: plain HTTP behind the host edge Caddy (which terminates TLS).
#
# The app-router listens on container port 12080 (consolidated-architecture
# §5.3); compose maps host 12180 -> container 12080. The host Caddy
# (/home/momo/Caddyfile) terminates TLS for *.dev.zukkafabrik.de and proxies
# plain HTTP to 127.0.0.1:12180, so the stack Caddy must NOT do TLS itself.
#
# `admin off`: there is no admin API in DEV. Liveness is the site-level
# `/__zu/health` route, which is what scripts/smoke.sh probes.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static 127.0.0.1/32
	}
}

import routes.caddy

http://:12080 {
	handle /__zu/health {
		respond "ok" 200
	}
	import radio_zukka_routes
}

# #44 Metrics bridge (§3.8): scheduler is reachable via the shared `egress`
# network. HTTP (not TLS): the scrape path stays internal/DEV-only.
http://:12091 {
	reverse_proxy scheduler:9091
}
