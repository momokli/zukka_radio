# PROD behind the shared edge Caddy: no TLS here, just internal routing.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static 127.0.0.1/32
	}
}

import routes.caddy

http://:12080 {
	handle /__zu/health {
		respond "ok" 200
	}
	import radio_zukka_routes
}

# #44 Metrics bridge (§3.8): the shared Prometheus scrapes the scheduler over
# this port in the `mellon-network`. No TLS, no auth — internal scrape path.
http://:12091 {
	reverse_proxy scheduler:9091
}
